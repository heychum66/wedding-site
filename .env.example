# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# The password Evan & Remy type at /admin.
ADMIN_PASSWORD=

# Long random string used to sign the admin cookie. Generate one with: openssl rand -hex 32
ADMIN_SECRET=

# Optional: your custom domain, used in the .ics file and link previews (e.g. https://evanandremy.com)
NEXT_PUBLIC_SITE_URL=
